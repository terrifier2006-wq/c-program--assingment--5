#include <stdio.h>

long long calls = 0;

int digitalRoot(int n)
{
    if (n < 10)
        return n;

    int sum = 0;
    while (n > 0) {
        sum += n % 10;
        n /= 10;
    }
    return digitalRoot(sum);
}

long long power_linear(long long base, int exp)
{
    calls++;
    if (exp == 0)
        return 1;
    return base * power_linear(base, exp - 1);
}

long long power_fast(long long base, int exp)
{
    calls++;
    if (exp == 0)
        return 1;

    long long half = power_fast(base, exp / 2);

    if (exp % 2 == 0)
        return half * half;
    return base * half * half;
}

long long power_iterative(long long base, int exp)
{
    long long result = 1;
    while (exp > 0) {
        if (exp % 2 == 1)
            result *= base;
        base *= base;
        exp /= 2;
    }
    return result;
}

int main(void)
{
    int tests[] = {0, 1, 25, 9875, 99999};

    printf("DIGITAL ROOT TESTING\n");
    for (int i = 0; i < 5; i++)
        printf("%d -> %d\n", tests[i], digitalRoot(tests[i]));

    calls = 0;
    printf("\nPOWER FUNCTION TESTING\n");
    printf("Linear: %lld\n", power_linear(2, 30));
    printf("Linear calls: %lld\n", calls);

    calls = 0;
    printf("Fast: %lld\n", power_fast(2, 30));
    printf("Fast calls: %lld\n", calls);

    printf("Iterative: %lld\n", power_iterative(2, 30));

    printf("\nCALL COUNT MEASUREMENT (base = 1)\n");
    int values[] = {10, 100, 1000, 10000};

    printf("n\tLinear calls\tFast calls\n");
    for (int i = 0; i < 4; i++) {
        int n = values[i];

        calls = 0;
        power_linear(1, n);
        long long linear_calls = calls;

        calls = 0;
        power_fast(1, n);
        long long fast_calls = calls;

        printf("%d\t%lld\t\t%lld\n", n, linear_calls, fast_calls);
    }

    return 0;
}

